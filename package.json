{
  "name": "sastragetway",
  "productName": "DIGITALIKH GETWAY",
  "version": "2.0.5",
  "description": "DIGITALIKH GETWAY - Neural AI Gateway & Desktop Router",
  "main": "main.js",
  "author": "Sastra AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/pphanet01-hash/Digitalikh_GetWay.git"
  },
  "scripts": {
    "start": "electron .",
    "keygen": "electron admin-keygen/keygen-main.js",
    "admin": "node license/admin-dashboard.js",
    "build": "npx electron-builder --win nsis --publish never",
    "build:win": "npx electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.sastraai.sastragetway",
    "productName": "DIGITALIKH GETWAY",
    "publish": [
      {
        "provider": "github",
        "owner": "pphanet01-hash",
        "repo": "Digitalikh_GetWay"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DIGITALIKH GETWAY",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "activate.html",
      "activate.js",
      "dashboard.html",
      "chrome-extension/**/*",
      "splash.html",
      "fonts/**/*",
      "Piceture/**/*",
      "license/license-manager.js",
      "license/cloud-config.json",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/.git"
        ]
      }
    ],
    "asar": false
  },
  "devDependencies": {
    "electron": "^45.3.2"
  }
}